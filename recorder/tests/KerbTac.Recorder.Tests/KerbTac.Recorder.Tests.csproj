<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);KERBTAC_STUB_REFS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/KerbTac.Core/KerbTac.Core.csproj" />
    <Compile Include="../../src/KerbTac.Recorder/**/*.cs"
             Exclude="../../src/KerbTac.Recorder/bin/**;../../src/KerbTac.Recorder/obj/**"
             LinkBase="Recorder" />
    <Compile Include="../../refs-stub/*.cs" LinkBase="KspStubs" />
  </ItemGroup>
</Project>
